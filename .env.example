# ==============================================================================
# Environment Configuration Template (.env.example)
# Project: Lions Club of Balangoda Web Portal & Content Management System
# Course: IS5109 Community Project (Group 14)
# Security Requirement: SEC-04 (Secrets Management)
# ==============================================================================
# INSTRUCTIONS:
#   1. Copy this template to create your local development file:
#        cp .env.example .env.local
#   2. Populate each variable with your local environment credentials.
#   3. NEVER commit .env, .env.local, or real production secrets to Git!
#      Git tracks only .env.example with empty values.
# ==============================================================================

# ── Application Configuration ─────────────────────────────────────────────────
# Environment mode (development | test | production)
NODE_ENV=

# Public application base URL (e.g. http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Frontend port (Next.js dev server, e.g. 3000)
PORT=

# ── Backend API Configuration (Express server/) ───────────────────────────────
# Backend API port (e.g. 4000)
API_PORT=

# Public API URL accessible from client browser (e.g. http://localhost:4000)
NEXT_PUBLIC_API_URL=

# ── Database Configuration (PostgreSQL / SQLite) ──────────────────────────────
# Primary PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=

# Individual connection parameters (fallback when DATABASE_URL is not set)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── Authentication & Session Security (NextAuth / JWT) ────────────────────────
# Cryptographically secure random secret (generate via: openssl rand -base64 32)
NEXTAUTH_SECRET=

# NextAuth canonical URL (matches application base URL, e.g. http://localhost:3000)
NEXTAUTH_URL=

# ── Media CDN & Cloud Storage (Cloudinary - Proposal Section 1.4) ─────────────
# Cloudinary cloud name from console (e.g. balangoda-lions)
CLOUDINARY_CLOUD_NAME=

# Cloudinary public API key
CLOUDINARY_API_KEY=

# Cloudinary private API secret (STRICTLY SERVER-SIDE - NEVER EXPOSE TO CLIENT)
CLOUDINARY_API_SECRET=

# ── Email Notifications (SMTP - Volunteer & Inquiry Forms, Password Reset) ────
# SMTP host server (e.g. smtp.resend.com or smtp.gmail.com)
SMTP_HOST=

# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=

# SMTP authentication username
SMTP_USER=

# SMTP authentication password / app password (STRICTLY SERVER-SIDE)
SMTP_PASSWORD=

# SMTP secure connection flag (true for 465, false for 587)
SMTP_SECURE=

# Sender email address displayed in outgoing emails
EMAIL_FROM=

# Club administrative recipient email for contact inquiries & volunteer signups
ADMIN_NOTIFICATION_EMAIL=
