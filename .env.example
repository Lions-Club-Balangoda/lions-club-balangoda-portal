# ==============================================================================
# Environment Configuration Template (.env.example)
# Project: Lions Club of Balangoda Web Portal & CMS  (Group 14, IS5109)
# ==============================================================================
# INSTRUCTIONS:
#   1. Copy this file to create your local environment file:
#        cp .env.example .env.local
#   2. Replace ALL placeholder values with your actual local credentials.
#   3. NEVER commit .env, .env.local, or any real secrets to Git.
#      The .gitignore already blocks those files.
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Frontend port (Next.js dev server) ────────────────────────────────────────
PORT=3000

# ── Backend API port (Express, server/) ───────────────────────────────────────
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Full connection string takes precedence over individual variables.
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/lions_club_balangoda
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lions_club_balangoda
DB_USER=db_user
DB_PASSWORD=db_password

# ── Authentication (NextAuth / JWT) ──────────────────────────────────────────
# Generate a strong secret:  openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_your_generated_secret
NEXTAUTH_URL=http://localhost:3000

# ── Media CDN (Cloudinary) ──────────────────────────────────────────────────
# See: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Email Notifications (SMTP — Volunteer & Inquiry forms, Password Reset) ──
# Compatible with Resend, Brevo, SendGrid, or Gmail SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_SECURE=false
EMAIL_FROM=noreply@balangodalions.org
ADMIN_NOTIFICATION_EMAIL=admin@balangodalions.org

