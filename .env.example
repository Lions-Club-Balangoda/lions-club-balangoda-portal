# ==============================================================================
# Environment Configuration Template (.env.example)
# Project: Lions Club of Balangoda Web Portal & CMS
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to create your local environment file:
#    cp .env.example .env.local
# 2. Replace all placeholder values with your local development credentials.
# 3. NEVER commit .env, .env.local, or real production secrets to Git!
# ==============================================================================

# Application Configuration
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL / MySQL)
# Example URL format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/lions_club_balangoda
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lions_club_balangoda
DB_USER=db_user
DB_PASSWORD=db_password

# Authentication (NextAuth / JWT)
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Media CDN & Storage (Cloudinary - see Docs/project-proposal.md Section 1.4)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Notification Service (SMTP for Volunteer Signups & Inquiries)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_SECURE=false
EMAIL_FROM=noreply@balangodalions.org
ADMIN_NOTIFICATION_EMAIL=admin@balangodalions.org
