{
  "name": "lions-club-balangoda-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "server:dev": "node --experimental-strip-types --watch server/index.ts",
    "server:build": "tsc --project tsconfig.server.json",
    "test": "node --experimental-strip-types --test tests/projects-api.test.mjs tests/projects-ui.test.mjs tests/projects-list.test.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
