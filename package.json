{
  "name": "lions-club-balangoda-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "server:dev": "node --experimental-strip-types --watch server/index.ts",
    "server:build": "tsc --project tsconfig.server.json",
    "test": "node --experimental-strip-types --test tests/projects-api.test.mjs tests/projects-ui.test.mjs tests/projects-list.test.mjs tests/projects-search.test.mjs tests/auth-password.test.mjs tests/secrets-scan.test.mjs"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
    "bcryptjs": "^3.0.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
